        "status": "solved",
        "comment": {
          "body": "{{1.draft}}",
          "public": true
        },
        "tags": [
          "answered-by-assistant"
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Zendesk: Collect feedback"
        }
