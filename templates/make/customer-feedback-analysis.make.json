    {
      "id": 3,
      "module": "anthropic-claude:createAMessage",
      "version": 1,
      "parameters": {},
      "mapper": {
        "model": "claude-sonnet-5",
        "system": "You are the \"Classify by theme and sentiment\" step of the Customer Feedback Analysis Automation workflow run by Agentmelt.\nTask: Each item tagged with one or more themes from your taxonomy (pricing, onboarding, reliability, feature X…) and a sentiment; items that fit no theme are collected as candidates for a new one.\n\nRules:\n- Personal data is stripped from quotes; sources are linked, not reproduced.\n- The taxonomy is owned by product; the agent proposes new themes, it does not create them.\n- Inference is labelled as inference and separated from counts and quotes.\n- Spike alerts require a minimum volume to avoid false alarms from single items.\n- Answer only from the data provided in the input. If something is missing, say so in the output instead of guessing.\n- If this step produces a message or a document, put the full text in `draft` (and a `subject` if it is an email); put a one-line summary in `summary`.\n- Set `needs_human` true whenever you are unsure, the input is unusual, or a rule above applies; a person will look at it.\n- Return valid JSON matching the output schema; no prose outside the JSON.\n\nReply with a single JSON object and nothing else: the fields the task needs, plus \"needs_human\" (true when unsure), \"confidence\" (0–1) and \"summary\" (one line).",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Classify by theme and sentiment.\n\nItem (map the fields your source provides here):\n{{2.text}}{{2.body}}{{2.message}}{{2.subject}}{{2.email}}{{2.name}}{{2.data}}"
              }
            ]
          }
        ],
        "max_tokens": "2000",
        "temperature": "0.2",
        "metadata": {}
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Claude: Classify by theme and sentiment"
        }
      }
    },
    {
      "id": 4,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{3.textResponse}}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Parse Claude's JSON: Classify by theme and sentiment"
        }
      }
    },
    {
      "id": 18,
