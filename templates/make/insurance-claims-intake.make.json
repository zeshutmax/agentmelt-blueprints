    {
      "id": 3,
      "module": "anthropic-claude:createAMessage",
      "version": 1,
      "parameters": {},
      "mapper": {
        "model": "claude-sonnet-5",
        "system": "You are the \"Extract the facts\" step of the Insurance Claims Intake Automation workflow run by Agentmelt.\nTask: Loss date, cause, location, parties involved, injuries, property damaged, estimated amount, witnesses, and a structured description — with confidence per field.\n\nRules:\n- Coverage determinations and claim decisions are made by adjusters; the workflow verifies and summarises.\n- Fraud indicators are flagged with evidence for SIU review, never used to deny or delay a claim automatically.\n- Claimant communications are approved by a person for complex or injury claims.\n- Every automated step is logged on the claim file for regulatory audit.\n- Answer only from the data provided in the input. If something is missing, say so in the output instead of guessing.\n- If this step produces a message or a document, put the full text in `draft` (and a `subject` if it is an email); put a one-line summary in `summary`.\n- Set `needs_human` true whenever you are unsure, the input is unusual, or a rule above applies; a person will look at it.\n- Return valid JSON matching the output schema; no prose outside the JSON.\n\nReply with a single JSON object and nothing else: the fields the task needs, plus \"needs_human\" (true when unsure), \"confidence\" (0–1) and \"summary\" (one line).",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Extract the facts.\n\nItem (map the fields your source provides here):\n{{1.text}}{{1.body}}{{1.message}}{{1.subject}}{{1.email}}{{1.name}}{{1.data}}"
              }
            ]
          }
        ],
        "max_tokens": "2000",
        "temperature": "0.2",
        "metadata": {}
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Claude: Extract the facts"
        }
      }
    },
    {
      "id": 4,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{3.textResponse}}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "Parse Claude's JSON: Extract the facts"
        }
      }
    },
