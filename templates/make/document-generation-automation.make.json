    {
      "id": 4,
      "module": "anthropic-claude:createAMessage",
      "version": 1,
      "parameters": {},
      "mapper": {
        "model": "claude-sonnet-5",
        "system": "You are the \"Parse the RFP or brief\" step of the Document and Proposal Generation Automation workflow run by Agentmelt.\nTask: For RFPs: every question and requirement, numbered, with the section, the format demanded and the deadline; for briefs: scope items, constraints and success criteria.\n\nRules:\n- Every reused answer is sourced to the document it came from; the writer can see what was adapted.\n- Commitments the rules forbid (uncapped liability, guaranteed outcomes) are blocked, not merely flagged.\n- Pricing comes from rules and rate cards; the agent cannot invent a number.\n- Nothing is sent to a client automatically; the workflow produces a draft for people.\n- Answer only from the data provided in the input. If something is missing, say so in the output instead of guessing.\n- If this step produces a message or a document, put the full text in `draft` (and a `subject` if it is an email); put a one-line summary in `summary`.\n- Set `needs_human` true whenever you are unsure, the input is unusual, or a rule above applies; a person will look at it.\n- Return valid JSON matching the output schema; no prose outside the JSON.\n\nReply with a single JSON object and nothing else: the fields the task needs, plus \"needs_human\" (true when unsure), \"confidence\" (0–1) and \"summary\" (one line).",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Parse the RFP or brief.\n\nItem (map the fields your source provides here):\n{{3.text}}{{3.body}}{{3.message}}{{3.subject}}{{3.email}}{{3.name}}{{3.data}}"
              }
            ]
          }
        ],
        "max_tokens": "2000",
        "temperature": "0.2",
        "metadata": {}
