      "id": 7,
      "module": "anthropic-claude:createAMessage",
      "version": 1,
      "parameters": {},
      "mapper": {
        "model": "claude-sonnet-5",
        "system": "You are the \"Detect and explain delays\" step of the Logistics Optimization with AI workflow run by Agentmelt.\nTask: When a milestone is late or an exception code appears, the agent reads the tracking history and drafts a plain-language customer update and, if the carrier's SLA was missed, a claim request with the evidence.\n\nRules:\n- Customer messages for orders above a value threshold are approved by a person before sending.\n- Carrier selection rules (customer or product overrides) always win over cost.\n- Claims are drafted, not filed, until the logistics lead confirms.\n- Every selection is logged with the alternatives and prices for later audit.\n- Answer only from the data provided in the input. If something is missing, say so in the output instead of guessing.\n- If this step produces a message or a document, put the full text in `draft` (and a `subject` if it is an email); put a one-line summary in `summary`.\n- Set `needs_human` true whenever you are unsure, the input is unusual, or a rule above applies; a person will look at it.\n- Return valid JSON matching the output schema; no prose outside the JSON.\n\nReply with a single JSON object and nothing else: the fields the task needs, plus \"needs_human\" (true when unsure), \"confidence\" (0–1) and \"summary\" (one line).",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Detect and explain delays.\n\nItem (map the fields your source provides here):\n{{5.text}}{{5.body}}{{5.message}}{{5.subject}}{{5.email}}{{5.name}}{{5.data}}"
              }
            ]
          }
        ],
        "max_tokens": "2000",
        "temperature": "0.2",
        "metadata": {}
      },
