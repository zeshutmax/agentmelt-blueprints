            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Qualify.\n\nItem (map the fields your source provides here):\n{{3.text}}{{3.body}}{{3.message}}{{3.subject}}{{3.email}}{{3.name}}{{3.data}}"
              }
            ]
          }
        ],
