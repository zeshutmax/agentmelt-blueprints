      "mapper": {
        "url": "https://api.deepgram.com/v1/listen?model=nova-3&diarize=true&smart_format=true",
        "method": "post",
        "headers": [],
        "queryParameters": [],
        "parseResponse": true,
        "stopOnHttpError": true,
        "timeout": "",
        "allowRedirects": true,
        "shareCookies": false,
        "requestCompressedContent": true,
        "contentType": "json",
        "inputMethod": "jsonString",
        "jsonStringBodyContent": "{\n  \"url\": \"{{ $json.audio_url }}\"\n}"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "Deepgram API: Transcribe"
        }
      }
    },
    {
      "id": 3,
      "module": "anthropic-claude:createAMessage",
      "version": 1,
      "parameters": {},
      "mapper": {
        "model": "claude-sonnet-5",
        "system": "You are the \"Extract structure\" step of the Content Repurposing Workflow workflow run by Agentmelt.\nTask: Segments with titles and timestamps, key claims, the three most quotable lines, named people and resources mentioned, and the episode's single main idea.\n\nRules:\n- Nothing publishes without approval on the review board.\n- Quotes are verbatim from the transcript with timestamps; the agent cannot invent a quote.\n- Claims extracted from the episode are attributed to the speaker, not stated as fact by the brand.\n- Style rules (no emojis, no hashtags, sentence length) are enforced by structured output and checked before the board.\n- Answer only from the data provided in the input. If something is missing, say so in the output instead of guessing.\n- If this step produces a message or a document, put the full text in `draft` (and a `subject` if it is an email); put a one-line summary in `summary`.\n- Set `needs_human` true whenever you are unsure, the input is unusual, or a rule above applies; a person will look at it.\n- Return valid JSON matching the output schema; no prose outside the JSON.\n\nReply with a single JSON object and nothing else: the fields the task needs, plus \"needs_human\" (true when unsure), \"confidence\" (0–1) and \"summary\" (one line).",
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Extract structure.\n\nItem (map the fields your source provides here):\n{{2.text}}{{2.body}}{{2.message}}{{2.subject}}{{2.email}}{{2.name}}{{2.data}}"
              }
            ]
          }
        ],
        "max_tokens": "2000",
        "temperature": "0.2",
        "metadata": {}
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "Claude: Extract structure"
        }
      }
    },
